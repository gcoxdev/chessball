{
  "name": "chessball",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "simulate": "node --import tsx src/simulate-cli.ts",
