    "cdp_client": {
      "execution": "The exact recorded cdp_measurement command resolves the repository root, reads this tracked artifact, joins source_lines with newlines, exposes this baseline to the runner, and imports the source as a JavaScript data module.",
      "source_lines": [
        "const CDP_HTTP = 'http://127.0.0.1:9222';",
        "const PREVIEW_URL = 'http://127.0.0.1:4173/';",
        "const baseline = globalThis.__CHESSBALL_BASELINE__;",
        "if (!baseline) throw new Error('Stored baseline was not provided');",
        "const tolerance = 0;",
        "const forceMismatch = process.env.CHESSBALL_BASELINE_PROBE_MISMATCH === '1';",
        "",
        "const html = await (await fetch(PREVIEW_URL)).text();",
        "const cssHref = html.match(/href=\"([^\"]+\\.css)\"/)?.[1];",
        "if (!cssHref) throw new Error('Preview CSS href missing');",
        "const css = await (await fetch(new URL(cssHref, PREVIEW_URL))).text();",
        "const requiredMarkerPresent = css.includes(baseline.expected_source_markers.required_css_fragment);",
        "const forbiddenMarkerAbsent = !css.includes(baseline.expected_source_markers.forbidden_css_fragment);",
        "if (!requiredMarkerPresent || !forbiddenMarkerAbsent) {",
        "  throw new Error(`Served source mismatch: required=${requiredMarkerPresent}, forbiddenAbsent=${forbiddenMarkerAbsent}`);",
        "}",
        "",
        "const version = await (await fetch(`${CDP_HTTP}/json/version`)).json();",
        "const targets = await (await fetch(`${CDP_HTTP}/json`)).json();",
        "const page = targets.find((target) => target.type === 'page');",
        "if (!page?.webSocketDebuggerUrl) throw new Error('No CDP page target found');",
        "",
        "const socket = new WebSocket(page.webSocketDebuggerUrl);",
        "await new Promise((resolve, reject) => {",
        "  socket.addEventListener('open', resolve, { once: true });",
        "  socket.addEventListener('error', reject, { once: true });",
        "});",
        "",
        "let nextId = 0;",
        "const pending = new Map();",
        "const eventWaiters = new Map();",
        "socket.addEventListener('message', (event) => {",
        "  const message = JSON.parse(event.data);",
        "  if (message.id && pending.has(message.id)) {",
        "    const { resolve, reject } = pending.get(message.id);",
        "    pending.delete(message.id);",
        "    if (message.error) reject(new Error(JSON.stringify(message.error)));",
        "    else resolve(message.result);",
        "    return;",
        "  }",
        "  const waiters = eventWaiters.get(message.method);",
        "  if (!waiters) return;",
        "  eventWaiters.delete(message.method);",
        "  for (const resolve of waiters) resolve(message.params);",
        "});",
        "",
        "const send = (method, params = {}) => new Promise((resolve, reject) => {",
        "  const id = ++nextId;",
        "  pending.set(id, { resolve, reject });",
        "  socket.send(JSON.stringify({ id, method, params }));",
        "});",
        "const waitForEvent = (method) => new Promise((resolve) => {",
        "  const waiters = eventWaiters.get(method) ?? [];",
        "  waiters.push(resolve);",
        "  eventWaiters.set(method, waiters);",
        "});",
        "",
        "const rectExpression = `(() => {",
        "  const scoreStrip = document.querySelector('.score-strip');",
        "  const heading = document.querySelector('#game-workspace');",
        "  if (!scoreStrip || !heading) throw new Error('Required baseline selector missing');",
        "  const rect = (value) => ({ x: value.x, y: value.y, width: value.width, height: value.height, top: value.top, right: value.right, bottom: value.bottom, left: value.left });",
        "  return {",
        "    device_pixel_ratio: window.devicePixelRatio,",
        "    inner_width: window.innerWidth,",
        "    inner_height: window.innerHeight,",
        "    score_strip_bounding_rect: rect(scoreStrip.getBoundingClientRect()),",
        "    game_workspace_heading_bounding_rect: rect(heading.getBoundingClientRect()),",
        "    document: { scroll_width: document.documentElement.scrollWidth, client_width: document.documentElement.clientWidth }",
        "  };",
        "})()`;",
        "",
        "const numericPaths = [",
        "  'device_pixel_ratio', 'inner_width', 'inner_height',",
        "  ...['x', 'y', 'width', 'height', 'top', 'right', 'bottom', 'left'].map((key) => `score_strip_bounding_rect.${key}`),",
        "  ...['x', 'y', 'width', 'height', 'top', 'right', 'bottom', 'left'].map((key) => `game_workspace_heading_bounding_rect.${key}`),",
        "  'document.scroll_width', 'document.client_width'",
        "];",
        "const valueAt = (object, path) => path.split('.').reduce((value, key) => value[key], object);",
        "",
        "try {",
        "  await send('Page.enable');",
        "  await send('Runtime.enable');",
        "  await send('Emulation.setDeviceMetricsOverride', { width: 1440, height: 900, deviceScaleFactor: 1, mobile: false });",
        "  const loaded = waitForEvent('Page.loadEventFired');",
        "  await send('Page.navigate', { url: PREVIEW_URL });",
        "  await loaded;",
        "  for (let attempt = 0; attempt < 100; attempt += 1) {",
        "    const ready = await send('Runtime.evaluate', {",
        "      expression: `document.readyState === 'complete' && Boolean(document.querySelector('.score-strip')) && Boolean(document.querySelector('#game-workspace'))`,",
        "      returnByValue: true",
        "    });",
        "    if (ready.result.value) break;",
        "    if (attempt === 99) throw new Error('Preview did not become ready');",
        "    await new Promise((resolve) => setTimeout(resolve, 50));",
        "  }",
        "",
        "  const measured = await send('Runtime.evaluate', { expression: rectExpression, returnByValue: true });",
        "  const actual = measured.result.value;",
        "  const expected = structuredClone(baseline.measurements);",
        "  if (forceMismatch) expected.score_strip_bounding_rect.height += 1;",
        "  const differences = numericPaths.map((path) => ({",
        "    path,",
        "    expected: valueAt(expected, path),",
        "    actual: valueAt(actual, path),",
        "    delta: valueAt(actual, path) - valueAt(expected, path)",
        "  })).filter((item) => Math.abs(item.delta) > tolerance);",
        "  if (differences.length > 0) throw new Error(`Baseline geometry mismatch: ${JSON.stringify(differences)}`);",
        "",
        "  const screenshot = await send('Page.captureScreenshot', { format: 'png', fromSurface: true });",
        "  screenshot.data = '';",
        "  console.log(JSON.stringify({",
        "    browser: version.Browser,",
        "    protocol_version: version['Protocol-Version'],",
        "    source_markers: { css_href: cssHref, required_present: true, forbidden_absent: true },",
        "    geometry_validation: { result: 'exact_match', tolerance_pixels: tolerance, values: actual },",
        "    screenshot: { captured_ephemerally: true, equality_scope: 'excluded', disposition: 'discarded in memory; no PNG written or retained' }",
        "  }, null, 2));",
        "} finally {",
        "  socket.close();",
        "  await new Promise((resolve) => {",
        "    if (socket.readyState === WebSocket.CLOSED) resolve();",
        "    else socket.addEventListener('close', resolve, { once: true });",
        "  });",
        "}"
      ]
    },
